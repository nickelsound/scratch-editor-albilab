<!DOCTYPE html>
<html>
  <head>
    <% if (htmlWebpackPlugin.options.gtm_id) { %>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl+'<%= htmlWebpackPlugin.options.gtm_env_auth %>';
        f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','<%- htmlWebpackPlugin.options.gtm_id %>');
    </script>
    <!-- End Google Tag Manager -->
    <% } %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=0.25">
    <meta name="google" value="notranslate">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="AlbiLAB Scratch">
    <link rel="icon" type="image/x-icon" href="static/favicon.ico">
    <link rel="shortcut icon" href="static/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="static/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="192x192" href="static/favicon-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="static/favicon-512x512.png">
    <link rel="apple-touch-icon" href="static/favicon-192x192.png">
    <link rel="manifest" href="static/manifest.json">
    <title><%= htmlWebpackPlugin.options.title %></title>
  </head>
  <body>
    <% if (htmlWebpackPlugin.options.gtm_id) { %>
      <!-- Google Tag Manager (noscript) -->
      <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=<%- htmlWebpackPlugin.options.gtm_id %><%= htmlWebpackPlugin.options.gtm_env_auth %>" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
      <!-- End Google Tag Manager (noscript) -->
    <% } %>
    <style>
      #piCameraGalleryPanel {
        position: fixed;
        right: 16px;
        top: 92px;
        z-index: 9999;
        display: none;
        overflow: hidden;
        border: 1px solid #d7dbe7;
        border-radius: 8px;
        background: #eef1f8;
        box-shadow: 0 18px 40px rgba(87, 94, 117, .24);
        width: min(620px, calc(100vw - 320px));
        height: min(760px, calc(100vh - 112px));
      }
      #piCameraGalleryPanel.open {
        display: block;
      }
      #piCameraGalleryFrame {
        width: 100%;
        height: 100%;
        border: 0;
        background: #eef1f8;
      }
    </style>
    <div id="piCameraGalleryPanel"><iframe id="piCameraGalleryFrame" title="Pi Kamera panel"></iframe></div>
    <script>
      (function () {
        try {
          var panel = document.getElementById('piCameraGalleryPanel');
          var frame = document.getElementById('piCameraGalleryFrame');
          var host = window.location.hostname || 'localhost';
          var galleryUrl = window.location.protocol + '//' + host + ':8088/gallery-embed?ui=v6';
          var loaded = false;
          var callbackKey = 'OPEN_PI_CAMERA_PANEL';

          function togglePanel() {
            if (!loaded) {
              frame.src = galleryUrl;
              loaded = true;
            } else {
              try {
                if (frame.contentWindow) frame.contentWindow.location.reload();
              } catch (e) {}
            }
            if (panel.className.indexOf('open') !== -1) {
              panel.className = '';
            } else {
              panel.className = 'open';
            }
          }

          function handleOpenRequest() {
            window.requestAnimationFrame(function () {
              window.setTimeout(togglePanel, 0);
            });
          }

          document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') panel.className = '';
          });

          window.addEventListener('open-pi-camera-panel', handleOpenRequest);
        } catch (err) {
          if (window.console && console.warn) console.warn('Pi Kamera panel disabled:', err);
        }
      })();
    </script>
  </body>
</html>
